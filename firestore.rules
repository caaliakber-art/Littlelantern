rules_version = '2';

// Little Lantern: only the owners and the parents they approve can read or write the game data.
// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() in ['ali.rgnprice@gmail.com', 'ca.aliakber@gmail.com'];
    }

    function isMember() {
      return isOwner()
        || (signedIn()
            && exists(/databases/$(database)/documents/fam/access)
            && myEmail() in get(/databases/$(database)/documents/fam/access).data.members);
    }

    // Family settings, lesson approvals and the access list.
    // Members read all of it; only owners change the access list.
    match /fam/{doc} {
      allow read: if isMember();
      allow write: if (doc == 'access' && isOwner()) || (doc != 'access' && isMember());
    }

    match /kids/{doc} {
      allow read, write: if isMember();
    }

    match /progress/{doc} {
      allow read, write: if isMember();
    }

    match /deeds/{doc} {
      allow read, write: if isMember();
    }

    // Join requests: anyone signed in can ask to join with their own email.
    // Owners see and clear requests; a person can see and cancel only their own.
    match /requests/{uid} {
      allow read, delete: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == myEmail();
    }
  }
}
